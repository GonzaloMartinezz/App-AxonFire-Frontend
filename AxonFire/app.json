{
  "expo": {
    "name": "AxonFire",
    "slug": "AxonFire",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#16181d",
          "sounds": ["./assets/siren.mp3"]
        }
      ]
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#16181d"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nicoag12.axonfire"
    },
    "android": {
      "package": "com.nicoag12.axonfire",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#16181d"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "ea3e82f6-533d-454d-8f71-1a7e2720dd3b"
      }
    },
    "owner": "nicoag12"
  }
}
